<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Redmond.Avalonia.Windowing.WindowResizeHandles"
             IsHitTestVisible="True">
  <Grid RowDefinitions="7,*,7" ColumnDefinitions="7,*,7">
    <Border Grid.Row="0" Grid.Column="0" Background="Transparent" Tag="NorthWest" PointerPressed="ResizeOnPointerPressed" />
    <Border Grid.Row="0" Grid.Column="1" Background="Transparent" Tag="North" PointerPressed="ResizeOnPointerPressed" />
    <Border Grid.Row="0" Grid.Column="2" Background="Transparent" Tag="NorthEast" PointerPressed="ResizeOnPointerPressed" />
    <Border Grid.Row="1" Grid.Column="0" Background="Transparent" Tag="West" PointerPressed="ResizeOnPointerPressed" />
    <Border Grid.Row="1" Grid.Column="2" Background="Transparent" Tag="East" PointerPressed="ResizeOnPointerPressed" />
    <Border Grid.Row="2" Grid.Column="0" Background="Transparent" Tag="SouthWest" PointerPressed="ResizeOnPointerPressed" />
    <Border Grid.Row="2" Grid.Column="1" Background="Transparent" Tag="South" PointerPressed="ResizeOnPointerPressed" />
    <Border Grid.Row="2" Grid.Column="2" Background="Transparent" Tag="SouthEast" PointerPressed="ResizeOnPointerPressed" />
  </Grid>
</UserControl>
