<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="using:Redmond.Avalonia.Controls"
             x:Class="Redmond.Avalonia.Windowing.WindowAppearanceSettingsPanel">
  <StackPanel Spacing="6">
    <shared:SettingsCard Header="Translucent background"
                         Description="Use the system window material when available">
      <shared:SettingsCard.Icon>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Text="◫" />
      </shared:SettingsCard.Icon>
      <ToggleSwitch x:Name="BackdropToggle" OnContent="On" OffContent="Off"
                    Click="BackdropOnClick" />
    </shared:SettingsCard>

    <shared:AnimatedSettingsExpander Header="Window corners"
                                     Description="Choose the outer window shape">
      <shared:AnimatedSettingsExpander.Icon>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Text="⌜" />
      </shared:AnimatedSettingsExpander.Icon>
      <StackPanel Spacing="8">
        <RadioButton x:Name="Windows10Corners" GroupName="RedmondWindowCorners"
                     Content="Windows 10 — square" Tag="Windows10" Click="CornerOnClick" />
        <RadioButton x:Name="Windows11Corners" GroupName="RedmondWindowCorners"
                     Content="Windows 11 — rounded" Tag="Windows11" Click="CornerOnClick" />
        <RadioButton x:Name="MacOSCorners" GroupName="RedmondWindowCorners"
                     Content="macOS — rounded" Tag="MacOS" Click="CornerOnClick" />
      </StackPanel>
    </shared:AnimatedSettingsExpander>

    <shared:AnimatedSettingsExpander Header="Title bar controls"
                                     Description="Choose title bar geometry independently from window corners">
      <shared:AnimatedSettingsExpander.Icon>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" Text="•••" />
      </shared:AnimatedSettingsExpander.Icon>
      <StackPanel Spacing="8">
        <RadioButton x:Name="Windows10Controls" GroupName="RedmondWindowControls"
                     Content="Windows 10" Tag="Windows10" Click="ControlOnClick" />
        <RadioButton x:Name="Windows11Controls" GroupName="RedmondWindowControls"
                     Content="Windows 11" Tag="Windows11" Click="ControlOnClick" />
        <RadioButton x:Name="MacOSControls" GroupName="RedmondWindowControls"
                     Content="macOS" Tag="MacOS" Click="ControlOnClick" />
      </StackPanel>
    </shared:AnimatedSettingsExpander>
  </StackPanel>
</UserControl>
