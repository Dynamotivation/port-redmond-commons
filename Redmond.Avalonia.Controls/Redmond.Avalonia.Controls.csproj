<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Redmond.Avalonia.Controls</AssemblyName>
    <RootNamespace>Redmond.Avalonia.Controls</RootNamespace>
    <Description>Shared custom Avalonia controls for Redmond Project applications.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Themes/**/*.axaml" />
  </ItemGroup>
</Project>
